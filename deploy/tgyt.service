[Unit]
Description=tgyt-uploader (Telegram bot + admin web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tgyt
Group=tgyt
WorkingDirectory=/opt/tgyt-uploader
EnvironmentFile=/etc/tgyt/tgyt.env
Environment=TGYT_ENV_FILE=/etc/tgyt/tgyt.env
ExecStart=/opt/tgyt-uploader/venv/bin/python -m bot.main
Restart=always
RestartSec=5
MemoryMax=2G
Nice=5

# Hardening (spec section 8)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tgyt /etc/tgyt
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
