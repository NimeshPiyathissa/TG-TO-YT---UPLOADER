# Telegram
API_ID=
API_HASH=
BOT_TOKEN=
# Pyrogram string session for the relay account; required for files >20MB.
USER_SESSION=
# Private channel id both BOT_TOKEN and USER_SESSION are members of (see README).
RELAY_CHAT_ID=
OWNER_TG_ID=

# OAuth / networking
# hostname | loopback
OAUTH_MODE=hostname
# Auto-detected at install.
PUBLIC_IP=
# e.g. 20-1-2-3.sslip.io, derived from PUBLIC_IP in hostname mode.
PUBLIC_HOST=
LOOPBACK_PORT=8721
WEB_PORT=443
PROJECT_AUDITED=false
YT_REGION_CODE=LK

# Web admin
ADMIN_USERNAME=admin
# Set once; hashed into the DB at first boot, then blanked here.
ADMIN_PASSWORD=
REQUIRE_TOTP=false
# Random string, generated by the installer.
SESSION_SECRET=

# Crypto & paths
FERNET_KEY_PATH=/etc/tgyt/fernet.key
JOBS_DIR=/var/lib/tgyt/jobs
DB_PATH=/var/lib/tgyt/tgyt.db

# Limits
MAX_FILE_BYTES=2147483648
UPLOAD_CHUNK_BYTES=8388608
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_UPLOADS=1
DEFAULT_PRIVACY=private
JOB_RETENTION_HOURS=24
# Never let downloads eat the last N bytes of the jobs volume (default 5 GiB).
MIN_FREE_DISK_BYTES=5368709120

LOG_LEVEL=INFO
